    { text: "D-7~D-6  Olanzapine 10mg qd [D]", indent: 1, italic: true },
    { text: "D-5~D-4  Serotonin antagonist IV", indent: 1, italic: true, checkbox: true, id: "ae-d5" },
    { text: "고위험군 (D-3, D-2)", indent: 1, italic: true },
